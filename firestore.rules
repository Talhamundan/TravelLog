rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function ownsExistingData() {
      return signedIn() && resource.data.userId == request.auth.uid;
    }

    match /users/{userId} {
      allow read, update, delete: if signedIn() && userId == request.auth.uid;
      allow create: if signedIn() && userId == request.auth.uid;
    }

    match /{collection}/{docId} {
      allow read, update, delete: if collection in ['trips', 'companies', 'vehicles', 'locations', 'expenses', 'settings'] && ownsExistingData();
      allow create: if collection in ['trips', 'companies', 'vehicles', 'locations', 'expenses', 'settings']
        && signedIn()
        && request.auth.uid == request.resource.data.userId;
    }
  }
}
